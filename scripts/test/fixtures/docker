#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "compose" && "${2:-}" == "version" ]]; then
  printf 'Docker Compose fixture\n'
  exit 0
fi

if [[ "${1:-}" == "compose" && "${2:-}" == "config" && "${3:-}" == "--format" && "${4:-}" == "json" ]]; then
  printf '%s\n' '{"services":{"frontend":{"ports":[{"host_ip":"127.0.0.1","published":"4173","target":80}]},"backend":{},"postgres":{}}}'
  exit 0
fi

printf 'unsupported docker fixture arguments: %s\n' "$*" >&2
exit 64
